{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-and-lint.sh\"",
            "timeout": 60,
            "statusMessage": "Formateando y pasando el linter..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/bump-agents-version.sh\"",
            "timeout": 15,
            "statusMessage": "Actualizando versión de AGENTS.md..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-branch.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(backend/.adonisjs/**)",
      "Edit(backend/database/schema.ts)"
    ]
  }
}
